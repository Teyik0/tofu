{
  "name": "@tofu/anilist",
  "version": "0.0.0",
  "private": true,
  "description": "Official AniList plugin for Tofu",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/server/service.ts",
    "./oauth": "./src/server/oauth.ts",
