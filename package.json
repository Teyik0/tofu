{
  "name": "tofu",
  "version": "0.2.0",
  "private": true,
  "description": "Torrent client powered by Bun, Furin, and Electrobun",
  "bugs": {
    "url": "https://github.com/Teyik0/Tofu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teyik0/Tofu.git"
  },
  "license": "MIT",
  "author": "teyik0",
  "type": "module",
  "scripts": {
    "bench:ui": "bun scripts/native-latency.ts",
    "build": "bun scripts/build.ts web",
    "build:desktop": "bun scripts/build.ts desktop",
    "build:release": "TOFU_RELEASE=1 bun scripts/build.ts release",
    "commitlint": "bun --bun node_modules/@commitlint/cli/cli.js",
    "demo": "bun scripts/demo.ts",
    "desktop": "bun scripts/desktop.ts",
    "dev": "TOFU_PROFILE=dev bun --hot scripts/dev.ts",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "setup": "bun scripts/setup.ts",
    "start": "TOFU_MODE=server bun .furin/build/bun/server.js",
    "test": "bun test --parallel --isolate --bail",
    "test:background": "bun scripts/native-background.ts",
    "test:coexist": "bun scripts/native-coexist.ts",
    "test:native": "bun scripts/native-smoke.ts",
    "tscheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@elysia/eden": "2.0.0-beta.5",
    "@teyik0/furin": "0.7.0-alpha.2",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "elysia": "2.0.0-beta.21",
    "lucide-react": "1.52.0",
    "parse-torrent": "11.0.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typebox": "1.3.34",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webtorrent": "3.0.0",
    "bittorrent-tracker": "11.2.3",
    "electrobun": "2.0.2",
    "lefthook": "2.1.14",
    "shadcn": "4.21.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.1"
  }
}
