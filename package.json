{
  "name": "@tofu/workspace",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "package/*"
    ]
  },
  "scripts": {
    "build": "bun run --filter '@tofu/*' build",
    "build:desktop": "bun run --filter @tofu/desktop build:desktop",
    "build:release": "bun run --filter @tofu/desktop build:release",
    "codegen": "bun run --filter @tofu/desktop codegen",
    "codegen:check": "bun run --filter @tofu/desktop codegen:check",
    "codegen:routes": "bun run --filter @tofu/desktop codegen:routes",
    "codegen:schema": "bun run --filter @tofu/desktop codegen:schema",
    "commitlint": "bun --bun node_modules/@commitlint/cli/cli.js",
    "db:check": "bun run --filter @tofu/desktop db:check",
    "db:generate": "bun run --filter @tofu/desktop db:generate",
    "desktop": "bun run --filter @tofu/desktop desktop",
    "dev": "bun run --filter @tofu/desktop dev",
    "dev:desktop": "bun run --filter @tofu/desktop dev:desktop",
    "dev:docs": "bun run --filter @tofu/docs dev",
    "dev:web": "bun run --filter @tofu/desktop dev:web",
    "fix": "ultracite fix",
    "plugin:generate": "bun apps/tofu/scripts/plugins.ts generate",
    "plugin:install": "bun apps/tofu/scripts/plugins.ts install",
    "plugin:list": "bun apps/tofu/scripts/plugins.ts list",
    "plugin:uninstall": "bun apps/tofu/scripts/plugins.ts uninstall",
    "prepare": "lefthook install",
    "setup": "bun run --filter @tofu/desktop setup",
    "start": "bun run --filter @tofu/desktop start",
    "test": "bun run --filter '@tofu/*' test",
    "test:background": "bun run --filter @tofu/desktop test:background",
    "test:coexist": "bun run --filter @tofu/desktop test:coexist",
    "test:native": "bun run --filter @tofu/desktop test:native",
    "tscheck": "bun run --filter '@tofu/*' tscheck"
  },
  "overrides": {
    "@elysia/eden": "2.0.0-beta.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "catalog": {
    "@base-ui/react": "1.9.0",
    "@elysia/eden": "2.0.0-beta.5",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "elysia": "2.0.0-beta.32",
    "lucide-react": "1.61.0",
    "parse-torrent": "11.0.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typebox": "1.3.34",
    "webtorrent": "3.0.21",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webtorrent": "3.0.0",
    "bittorrent-tracker": "11.2.3",
    "electrobun": "2.0.2",
    "lefthook": "2.2.2",
    "shadcn": "4.22.1",
    "typescript": "7.0.2",
    "ultracite": "8.0.1",
    "node-datachannel": "0.32.3",
    "@types/parse-torrent": "11.0.1",
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "evlog": "^2.33.0",
    "@formisch/react": "1.1.0",
    "drizzle-orm": "1.0.0-rc.5",
    "graphql": "17.0.2",
    "graphql-request": "7.4.0",
    "jotai": "3.0.1",
    "valibot": "1.5.0",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript-generic-sdk": "5.0.1",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "drizzle-kit": "1.0.0-rc.5",
    "seroval": "1.5.3",
    "@teyik0/furin": "file:vendor/furin-pr163-420af31.tgz",
    "@teyik0/furin-electrobun": "file:vendor/furin-electrobun-pr163-420af31.tgz",
    "effect": "4.0.6",
    "libvlc-wasm": "0.2.0",
    "uqr": "0.1.3",
    "@graphql-codegen/schema-ast": "6.1.1"
  },
  "patchedDependencies": {
    "libvlc-wasm@0.2.0": "patches/libvlc-wasm@0.2.0.patch",
    "evlog@2.33.1": "patches/evlog@2.33.1.patch"
  },
  "trustedDependencies": [
    "node-datachannel"
  ]
}
