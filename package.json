{
  "name": "tofu",
  "version": "0.2.8",
  "private": true,
  "description": "Torrent client powered by Bun, Furin, Elysia and Electrobun",
  "bugs": {
    "url": "https://github.com/Teyik0/Tofu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teyik0/Tofu.git"
  },
  "license": "MIT",
  "author": "teyik0",
  "type": "module",
  "scripts": {
    "build": "bun run setup && bun run codegen && DATABASE_URL=./tofu-dev.sqlite bun --bun furin-electrobun build --env=dev",
    "codegen": "graphql-codegen --config scripts/anilist-codegen.ts",
    "db:generate": "DATABASE_URL=./tofu-dev.sqlite bunx --bun --no-install drizzle-kit generate",
    "db:push": "DATABASE_URL=./tofu-dev.sqlite bunx --bun --no-install drizzle-kit push",
    "dev": "bun run setup && bun run codegen && DATABASE_URL=./tofu-dev.sqlite bun --hot src/server.ts",
    "fix": "ultracite fix",
    "iup": "bun update --interactive --recursive",
    "prepare": "lefthook install",
    "setup": "bun scripts/setup.ts",
    "start": "open .furin/electrobun/build/dev-macos-arm64/Tofu.app",
    "test": "bun run codegen && bun test --parallel --isolate --bail --max-concurrency 3 --timeout 30000",
    "tscheck": "bun --bun furin-electrobun prepare && bun check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@elysia/eden": "2.0.0-beta.5",
    "@formisch/react": "1.1.0",
    "@teyik0/furin": "file:vendor/furin-pr163-2ce2321.tgz",
    "@teyik0/furin-electrobun": "file:vendor/furin-electrobun-pr163-2ce2321.tgz",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "1.0.0-rc.5",
    "elysia": "2.0.0-beta.32",
    "evlog": "^2.33.0",
    "graphql": "17.0.2",
    "graphql-request": "7.4.0",
    "jotai": "3.0.1",
    "libvlc-wasm": "0.2.0",
    "lucide-react": "1.61.0",
    "parse-torrent": "11.0.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uqr": "0.1.3",
    "valibot": "1.5.0",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/schema-ast": "6.1.1",
    "@graphql-codegen/typescript-generic-sdk": "5.0.1",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webtorrent": "3.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "electrobun": "2.0.2",
    "lefthook": "2.2.2",
    "shadcn": "4.22.1",
    "typescript": "7.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "patchedDependencies": {
    "libvlc-wasm@0.2.0": "patches/libvlc-wasm@0.2.0.patch"
  },
  "trustedDependencies": [
    "node-datachannel"
  ]
}
