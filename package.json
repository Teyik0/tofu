{
  "name": "@tofu/workspace",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "package/*"
    ]
  },
  "scripts": {
    "bench:ui": "bun run --filter @tofu/desktop bench:ui",
    "build": "bun run --filter '@tofu/*' build",
    "build:desktop": "bun run --filter @tofu/desktop build:desktop",
    "build:release": "bun run --filter @tofu/desktop build:release",
    "commitlint": "bun --bun node_modules/@commitlint/cli/cli.js",
    "demo": "bun run --filter @tofu/desktop demo",
    "desktop": "bun run --filter @tofu/desktop desktop",
    "dev": "bun run --filter @tofu/desktop dev",
    "dev:desktop": "bun run --filter @tofu/desktop dev:desktop",
    "dev:docs": "bun run --filter @tofu/docs dev",
    "fix": "ultracite fix",
    "plugin:generate": "bun apps/tofu/scripts/plugins.ts generate",
    "plugin:install": "bun apps/tofu/scripts/plugins.ts install",
    "plugin:list": "bun apps/tofu/scripts/plugins.ts list",
    "plugin:uninstall": "bun apps/tofu/scripts/plugins.ts uninstall",
    "prepare": "lefthook install",
    "setup": "bun run --filter @tofu/desktop setup",
    "start": "bun run --filter @tofu/desktop start",
    "test": "bun run --filter '@tofu/*' test",
    "test:background": "bun run --filter @tofu/desktop test:background",
    "test:coexist": "bun run --filter @tofu/desktop test:coexist",
    "test:hmr": "bun run --filter @tofu/desktop test:hmr",
    "test:native": "bun run --filter @tofu/desktop test:native",
    "tscheck": "bun run --filter '@tofu/*' tscheck"
  },
  "overrides": {
    "@elysia/eden": "2.0.0-beta.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "catalog": {
    "@base-ui/react": "1.8.0",
    "@elysia/eden": "2.0.0-beta.5",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "elysia": "2.0.0-beta.21",
    "lucide-react": "1.52.0",
    "parse-torrent": "11.0.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typebox": "1.3.34",
    "webtorrent": "3.0.21",
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webtorrent": "3.0.0",
    "bittorrent-tracker": "11.2.3",
    "electrobun": "2.0.2",
    "lefthook": "2.1.14",
    "shadcn": "4.21.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.1",
    "node-datachannel": "0.32.3",
    "@types/parse-torrent": "11.0.1",
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "evlog": "2.30.1"
  }
}
