{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  // Preserve the approved design artifact and GraphQL Code Generator's native output.
  "files": {
    "includes": [
      "!docs/remote-servers/design/ui-prototype.html",
      "!package/anilist/src/server/graphql/generated.ts"
    ]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      },
      "complexity": {
        "noVoid": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["package/anilist/src/server/graphql/schema.graphql"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "apps/tofu/src/components/**",
        "package/anilist/src/components/**",
        "package/anilist/src/pages/**",
        "package/ui/src/**",
        "apps/tofu/src/pages/anilist/_*.{ts,tsx}",
        "apps/tofu/src/pages/options/connections/_*.tsx",
        "apps/tofu/src/pages/plugins/_plugin-*.tsx",
        "apps/tofu/src/pages/plugins/_use-plugin-card.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/tofu/src/styles.css"],
      "assist": {
        "actions": {
          "source": {
            "useSortedProperties": "off"
          }
        }
      },
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
