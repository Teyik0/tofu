{
  "name": "@tofu/desktop",
  "version": "0.2.8",
  "private": true,
  "description": "Torrent client powered by Bun, Furin, and Electrobun",
  "bugs": {
    "url": "https://github.com/Teyik0/Tofu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teyik0/Tofu.git"
  },
  "license": "MIT",
  "author": "teyik0",
  "type": "module",
  "scripts": {
    "build": "bun run setup && bun run codegen && bun scripts/build.ts",
    "build:desktop": "bun run build",
    "build:release": "TOFU_PROFILE=release bun run build",
    "codegen": "bun scripts/plugins.ts generate && bun run --filter @tofu/anilist codegen",
    "codegen:check": "bun run --filter @tofu/anilist codegen:check",
    "codegen:routes": "bun --bun furin typegen",
    "codegen:schema": "bun run --filter @tofu/anilist codegen:schema",
    "db:check": "bun --bun drizzle-kit check",
    "db:generate": "bun --bun drizzle-kit generate",
    "desktop": "bun --cwd .furin/electrobun --bun ../../node_modules/electrobun/bin/electrobun.cjs run --env=dev",
    "dev": "bun run setup && bun run codegen && DATABASE_URL=./tofu-dev.sqlite bun --bun furin dev",
    "dev:desktop": "bun run dev --desktop",
    "dev:web": "bun run dev --web",
    "iup": "bun update --interactive --recursive",
    "plugin:generate": "bun scripts/plugins.ts generate",
    "plugin:install": "bun scripts/plugins.ts install",
    "plugin:list": "bun scripts/plugins.ts list",
    "plugin:uninstall": "bun scripts/plugins.ts uninstall",
    "setup": "bun scripts/setup.ts",
    "start": "bun --cwd .furin/electrobun --bun ../../node_modules/electrobun/bin/electrobun.cjs run --env=dev",
    "test": "bun run codegen && bun test --parallel=2 --isolate --bail --max-concurrency 3 --timeout 30000",
    "test:background": "bun run test tests/updates/native.test.ts",
    "test:coexist": "bun run test tests/lifecycle/ownership.test.ts",
    "test:native": "bun run codegen && bun test --isolate --bail --timeout 30000 tests/updates/native.test.ts tests/lifecycle/startup.test.ts",
    "tscheck": "bun run codegen && bun --bun furin-electrobun prepare && bun --bun furin typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@elysia/eden": "catalog:",
    "@formisch/react": "catalog:",
    "@teyik0/furin": "catalog:",
    "@teyik0/furin-electrobun": "catalog:",
    "@tofu/anilist": "workspace:*",
    "@tofu/plugins": "workspace:*",
    "@tofu/ui": "workspace:*",
    "bun-plugin-tailwind": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "elysia": "catalog:",
    "evlog": "catalog:",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "jotai": "catalog:",
    "libvlc-wasm": "catalog:",
    "lucide-react": "catalog:",
    "node-datachannel": "catalog:",
    "parse-torrent": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typebox": "catalog:",
    "uqr": "catalog:",
    "valibot": "catalog:",
    "webtorrent": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/schema-ast": "catalog:",
    "@graphql-codegen/typescript-generic-sdk": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@types/bun": "catalog:",
    "@types/parse-torrent": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webtorrent": "catalog:",
    "bittorrent-tracker": "catalog:",
    "drizzle-kit": "catalog:",
    "electrobun": "catalog:",
    "lefthook": "catalog:",
    "seroval": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
