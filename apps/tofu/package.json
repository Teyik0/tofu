{
  "name": "@tofu/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Torrent client powered by Bun, Furin, and Electrobun",
  "bugs": {
    "url": "https://github.com/Teyik0/Tofu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teyik0/Tofu.git"
  },
  "license": "MIT",
  "author": "teyik0",
  "type": "module",
  "scripts": {
    "bench:ui": "bun scripts/native-latency.ts",
    "build": "bun scripts/build.ts web",
    "build:desktop": "bun scripts/build.ts desktop",
    "build:release": "TOFU_RELEASE=1 bun scripts/build.ts release",
    "demo": "bun scripts/demo.ts",
    "desktop": "bun scripts/desktop.ts",
    "dev": "TOFU_PROFILE=dev bun --hot scripts/dev.ts",
    "dev:desktop": "TOFU_RELEASE=0 TOFU_PROFILE=dev bun scripts/build.ts dev-desktop",
    "plugin:generate": "bun scripts/plugins.ts generate",
    "plugin:install": "bun scripts/plugins.ts install",
    "plugin:list": "bun scripts/plugins.ts list",
    "plugin:uninstall": "bun scripts/plugins.ts uninstall",
    "setup": "bun scripts/setup.ts",
    "start": "TOFU_MODE=server bun .furin/build/bun/server.js",
    "test": "bun scripts/plugins.ts generate && bun test --parallel --isolate --max-concurrency 8 --bail --timeout 30000",
    "test:background": "bun scripts/native-background.ts",
    "test:coexist": "bun scripts/native-coexist.ts",
    "test:hmr": "bun scripts/native-hmr.ts",
    "test:native": "bun scripts/native-smoke.ts",
    "tscheck": "bun scripts/plugins.ts generate && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@elysia/eden": "catalog:",
    "@teyik0/furin": "file:../../vendor/furin-pr163-914e82a.tgz",
    "@teyik0/furin-electrobun": "file:../../vendor/furin-electrobun-pr163-914e82a.tgz",
    "@tofu/anilist": "workspace:*",
    "@tofu/plugins": "workspace:*",
    "@tofu/ui": "workspace:*",
    "bun-plugin-tailwind": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "elysia": "catalog:",
    "evlog": "catalog:",
    "lucide-react": "catalog:",
    "parse-torrent": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typebox": "catalog:",
    "webtorrent": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/parse-torrent": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webtorrent": "catalog:",
    "bittorrent-tracker": "catalog:",
    "electrobun": "catalog:",
    "node-datachannel": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:"
  }
}
