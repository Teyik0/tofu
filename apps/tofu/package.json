{
  "name": "@tofu/desktop",
  "version": "0.2.4",
  "private": true,
  "description": "Torrent client powered by Bun, Furin, and Electrobun",
  "bugs": {
    "url": "https://github.com/Teyik0/Tofu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teyik0/Tofu.git"
  },
  "license": "MIT",
  "author": "teyik0",
  "type": "module",
  "scripts": {
    "bench:ui": "bun scripts/native-latency.ts",
    "prebuild": "bun run setup",
    "build": "bun run codegen && bun ../../node_modules/@teyik0/furin/src/cli/index.ts build --target bun",
    "prebuild:desktop": "TOFU_RELEASE=0 bun run setup",
    "build:desktop": "bun run codegen && TOFU_RELEASE=0 bun ../../node_modules/@teyik0/furin-electrobun/src/cli.ts build --env=dev",
    "prebuild:release": "TOFU_RELEASE=1 bun run setup",
    "build:release": "bun run codegen && TOFU_RELEASE=1 bun ../../node_modules/@teyik0/furin-electrobun/src/cli.ts build --env=stable",
    "postbuild:release": "bun scripts/release.ts artifacts",
    "codegen": "bun scripts/plugins.ts generate && bun run --filter @tofu/anilist codegen",
    "codegen:check": "bun run --filter @tofu/anilist codegen:check",
    "codegen:routes": "bun scripts/route-types.ts",
    "codegen:schema": "bun run --filter @tofu/anilist codegen:schema",
    "db:check": "bun --bun drizzle-kit check",
    "db:generate": "bun --bun drizzle-kit generate",
    "demo": "bun scripts/demo.ts",
    "desktop": "bun scripts/desktop.ts",
    "dev": "bun run codegen && TOFU_PROFILE=dev bun --hot src/server.ts",
    "predev:desktop": "TOFU_RELEASE=0 bun run setup",
    "dev:desktop": "bun run codegen && TOFU_RELEASE=0 TOFU_PROFILE=dev bun ../../node_modules/@teyik0/furin-electrobun/src/cli.ts dev",
    "iup": "bun update --interactive --recursive",
    "plugin:generate": "bun scripts/plugins.ts generate",
    "plugin:install": "bun scripts/plugins.ts install",
    "plugin:list": "bun scripts/plugins.ts list",
    "plugin:uninstall": "bun scripts/plugins.ts uninstall",
    "resources": "bun scripts/resources.ts",
    "setup": "bun scripts/setup.ts && bun run resources",
    "start": "TOFU_MODE=server bun .furin/build/bun/server.js",
    "test": "bun run codegen && bun test --parallel --max-concurrency 2 --isolate --bail --timeout 30000",
    "test:background": "bun run codegen && bun scripts/native-background.ts",
    "test:coexist": "bun run codegen && bun scripts/native-coexist.ts",
    "test:native": "bun scripts/native-smoke.ts",
    "tscheck": "bun run codegen && bun run codegen:routes && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@elysia/eden": "catalog:",
    "@formisch/react": "catalog:",
    "@teyik0/furin": "file:../../vendor/furin-pr163-53e7c56.tgz",
    "@teyik0/furin-electrobun": "file:../../vendor/furin-electrobun-pr163-53e7c56.tgz",
    "@tofu/anilist": "workspace:*",
    "@tofu/plugins": "workspace:*",
    "@tofu/ui": "workspace:*",
    "bun-plugin-tailwind": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "parse-torrent": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typebox": "catalog:",
    "valibot": "catalog:",
    "webtorrent": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript-generic-sdk": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webtorrent": "catalog:",
    "bittorrent-tracker": "catalog:",
    "drizzle-kit": "catalog:",
    "electrobun": "catalog:",
    "lefthook": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
