-    const err = new Error('VLC destroyed');
-    for (const p of this._pending.values()) p.reject(err);
-    this._pending.clear();
+    let deadline;
+    try {
+      // A stopped worker cannot answer player.stop() either. Bound the whole
+      // shutdown, including player destruction, before terminating the worker.
+      await Promise.race([
+        (async () => {
+          await Promise.allSettled([...this._players.values()].map((p) => p.destroy()));
+          await Promise.allSettled([this._rpc('dispose')]);
+        })(),
+        new Promise((resolve) => { deadline = setTimeout(resolve, 500); }),
+      ]);
+    } finally {
+      clearTimeout(deadline);
+      this.worker.terminate();
+      this._destroyed = true;
+      // Nothing will answer now: settle whatever is still waiting.
+      const err = new Error('VLC destroyed');
+      for (const p of this._pending.values()) p.reject(err);
+      this._pending.clear();
+    }
   }

