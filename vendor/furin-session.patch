index a9db4a1..5887625 100644
--- a/packages/core/tests/runtime/browser-events/browser-events-plugin.test.ts
+++ b/packages/core/tests/runtime/browser-events/browser-events-plugin.test.ts
@@ -27,6 +27,97 @@ const notifier: SyncNotifier = {
   subscribe: () => Promise.resolve({ unsubscribe: () => Promise.resolve() }),
 };
 
+test("a session signal closes its socket and releases its connection once", async () => {
+  const session = new AbortController();
+  let released = 0;
+  const app = new Elysia()
+    .use(
+      createBrowserEventsPlugin({
+        development: true,
+        sync: {
+          adapter,
+          notifier,
+          principal: () => "test",
+          connection: () => ({
+            signal: session.signal,
+            release() {
+              released += 1;
+            },
+          }),
+        },
+      })
+    )
+    .listen(0);
+  await app.modules;
+  await using cleanup = new AsyncDisposableStack();
+  cleanup.defer(async () => {
+    await app.stop(true);
+  });
+  const socket = new WebSocket(`ws://127.0.0.1:${app.server?.port}/_furin/events`);
+  cleanup.defer(() => socket.close());
+  const closed = Promise.withResolvers<CloseEvent>();
+  const timeout = setTimeout(() => closed.resolve(new CloseEvent("close", { code: 1000 })), 1500);
+  cleanup.defer(() => clearTimeout(timeout));
+  socket.addEventListener("close", closed.resolve, { once: true });
+  socket.addEventListener(
+    "error",
+    (event) => closed.reject(new Error(`Socket failed: ${JSON.stringify(event)}`)),
+    { once: true }
+  );
+  socket.addEventListener("message", () => session.abort(), { once: true });
+  expect((await closed.promise).code).toBe(4409);
+  expect(released).toBe(1);
+});
+
+test.each([false, true])(
+  "SSE releases its session when already aborted: %s",
+  async (alreadyAborted) => {
+    const session = new AbortController();
+    let released = 0;
+    if (alreadyAborted) {
+      session.abort();
+    }
+    const app = new Elysia().use(
+      createSseBrowserEventsPlugin({
+        development: true,
+        sync: {
+          adapter,
+          notifier,
+          principal: () => "test",
+          connection: () => ({
+            signal: session.signal,
+            release() {
+              released += 1;
+            },
+          }),
+        },
+      })
+    );
+    const response = await app.handle(new Request("http://localhost/_furin/events"));
+    const reader = response.body?.getReader();
+    if (!reader) {
+      throw new Error("Expected an SSE response body");
+    }
+    await using cleanup = new AsyncDisposableStack();
+    cleanup.defer(async () => {
+      await reader.cancel();
+    });
+    if (!alreadyAborted) {
+      await reader.read();
+      await reader.read();
+      session.abort();
+    }
+    const deadline = Promise.withResolvers<ReadableStreamReadResult<Uint8Array>>();
+    const timer = setTimeout(
+      () => deadline.resolve({ done: false, value: new Uint8Array() }),
+      1500
+    );
+    cleanup.defer(() => clearTimeout(timer));
+    expect((await Promise.race([reader.read(), deadline.promise])).done).toBe(true);
+    expect(released).toBe(1);
+  }
+);
+
