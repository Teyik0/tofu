+  if (!(admission && app.server)) {
+    return denied;
+  }
+  const peerAddress = app.server.requestIP(request)?.address;
+  return admission(request, {
+    desktopSession:
+      state.guard !== undefined &&
+      denied === undefined &&
+      peerAddress !== undefined &&
+      LOOPBACK_PEERS.test(peerAddress),
+    peerAddress,
+  });
